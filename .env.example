# Dog API v2 Base URL
EXPO_PUBLIC_API_BASE_URL=https://dogapi.dog/api/v2

# API Request Timeout (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Cache Expiration (in milliseconds - 24 hours default)
EXPO_PUBLIC_CACHE_TTL_MS=86400000

# Max Images Memory/Disk Cache Limit (MB)
EXPO_PUBLIC_IMAGE_CACHE_LIMIT_MB=100
